rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The only identity allowed to change anything: the owner's VERIFIED email.
    // Signing up with any other email (or an unverified one) grants nothing.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'josaphatkychiloz@gmail.com';
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || str(d[k], max); }
    function okProject(d) {
      return str(d.title, 120) && str(d.description, 600)
          && optStr(d, 'category', 40) && optStr(d, 'tech', 200) && optStr(d, 'link', 300) && optStr(d, 'imageUrl', 900000)
          && (!('status' in d) || d.status in ['live', 'delivered', 'building'])
          && (!('order' in d) || d.order is number);
    }

    // Default deny
    match /{document=**} { allow read, write: if false; }

    // Hero text + typing phrases: public read, admin write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage posts: public read, admin write (1 MiB doc limit also caps embedded images)
    match /posts/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && str(request.resource.data.title, 160) && str(request.resource.data.content, 4000);
      allow delete: if isAdmin();
    }

    // Projects (built-in ones are copied here on the first admin visit so they are editable)
    match /projects/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && okProject(request.resource.data);
      allow delete: if isAdmin();
    }

    // Contact form: anyone may CREATE a well-formed message; only the admin can read/modify/delete.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt'])
                    && str(request.resource.data.name, 80)    && request.resource.data.name.size() >= 2
                    && str(request.resource.data.email, 120)  && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
                    && (!('subject' in request.resource.data) || str(request.resource.data.subject, 120))
                    && str(request.resource.data.message, 3000) && request.resource.data.message.size() >= 10
                    && request.resource.data.status == 'unread'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
